[Unit]
Description=Schedule Parser (FastAPI, behind nginx)
After=network-online.target
Wants=network-online.target

[Service]
User=schedule
Group=schedule
WorkingDirectory=/opt/schedule-parser
Environment=TARGET_GROUP=К0609-24
Environment=WEEKS_AHEAD=2
ExecStart=/opt/schedule-parser/.venv/bin/python3 -m uvicorn server:app --host 127.0.0.1 --port 8090 --no-server-header --no-access-log
Restart=always
RestartSec=5
OOMScoreAdjust=-500
MemoryMax=200M
StateDirectory=schedule-parser
StateDirectoryMode=0700

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
